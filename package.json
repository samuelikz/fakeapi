{
  "name": "@samuelikz/fakegen",
  "version": "0.1.0",
  "description": "Gerador de dados de exemplo determinístico (seed), sem dependências, com locales e data de referência fixa",
  "main": "src/index.js",
  "files": [
    "src"
  ],
  "sideEffects": false,
  "license": "MIT",
  "scripts": {
